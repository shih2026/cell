{
  "entities": {
    "ScoreSubmission": {
      "title": "Score Submission",
      "description": "A student's score submission",
      "type": "object",
      "properties": {
        "school": { "type": "string" },
        "classNo": { "type": "string" },
        "seatNo": { "type": "string" },
        "learningScore": { "type": "number" },
        "factoryHighScore": { "type": "number" },
        "sortingHighScore": { "type": "number" },
        "summaryHighScore": { "type": "number" },
        "totalScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["school", "classNo", "seatNo", "learningScore", "factoryHighScore", "sortingHighScore", "summaryHighScore", "totalScore", "createdAt"]
    }
  },
  "firestore": {
    "students/{studentId}": {
      "schema": { "$ref": "#/entities/ScoreSubmission" },
      "description": "Student high scores"
    }
  }
}
